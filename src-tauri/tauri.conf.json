{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocab Learning",
  "version": "0.1.0",
  "identifier": "com.vocablearning.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vocab Learning",
        "width": 320,
        "height": 440,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "center": false
      },
      {
        "label": "quick-add",
        "title": "Add Word",
        "width": 420,
        "height": 132,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "center": true
      },
      {
        "label": "manager",
        "title": "Vocabulary Manager",
        "width": 760,
        "height": 580,
        "minWidth": 680,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 13
        },
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 560,
        "height": 460,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
